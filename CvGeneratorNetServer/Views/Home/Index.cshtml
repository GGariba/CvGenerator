@model CvGeneratorNetServer.Models.CvData
@using System.Text.RegularExpressions

@functions {
    public string GetYear(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr)) return "Present";
        if (dateStr.Equals("Present", StringComparison.OrdinalIgnoreCase)) return "Present";

        // Find any 4-digit number in the string to strictly return the year
        var match = Regex.Match(dateStr, @"\b\d{4}\b");
        return match.Success ? match.Value : dateStr;
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Personal?.Name - CV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="min-h-screen bg-slate-200 py-8 px-4 flex flex-col items-center font-sans">

    <button id="download-pdf-btn"
            class="mb-6 px-6 py-3 bg-indigo-600 text-white font-bold rounded-full shadow-lg hover:bg-indigo-700">
        Download as PDF
    </button>

    <div id="cv-template"
         class="w-[210mm] h-[295mm] max-h-[295mm] bg-white flex flex-col overflow-hidden relative cv-paper p-6 text-gray-800">
        <div class="flex justify-between items-start border-b-2 border-indigo-600 pb-4 mb-4 shrink-0">

            <div class="w-3/4 pr-6">
                <div class="flex items-baseline gap-3">
                    <h1 class="text-4xl text-gray-900 font-bold m-0">@Model?.Personal?.Name</h1>
                    <h2 class="text-lg font-semibold text-indigo-600 m-0">@Model?.Personal?.Title</h2>
                </div>
                @if (Model?.Personal?.About != null && Model.Personal.About.Any())
                {
                    <div class="mt-3 text-xs text-black leading-relaxed">
                        @foreach (var line in Model.Personal.About)
                        {
                            <p>@line</p>
                        }
                    </div>
                }
            </div>
            <div class="w-1/4 flex flex-col gap-2 text-sm text-gray-700 justify-end pt-2">

                @if (!string.IsNullOrWhiteSpace(Model?.Personal?.Email))
                {
                    <a href="mailto:@Model.Personal.Email"
                       class="flex items-center justify-end gap-2 hover:text-indigo-600 transition-colors group">
                        <span class="group-hover:underline">@Model.Personal.Email</span>
                        <svg width="16" height="16" class="w-4 h-4 text-indigo-600 shrink-0" fill="none" stroke="#4f46e5"
                             viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                            </path>
                        </svg>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model?.Personal?.Github))
                {
                    var githubDisplay = Model.Personal.Github?.Replace("https://", string.Empty,
                StringComparison.OrdinalIgnoreCase) ?? "GitHub";
                    <a href="@Model.Personal.Github" target="_blank" rel="noopener noreferrer"
                       class="flex items-center justify-end gap-2 hover:text-indigo-600 transition-colors group text-black">
                        <span class="group-hover:underline break-all">@githubDisplay</span>
                        <svg width="16" height="16" class="w-4 h-4 text-indigo-600 shrink-0" fill="#4f46e5"
                             viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd"
                                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678 .92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                                  clip-rule="evenodd"></path>
                        </svg>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model?.Personal?.LinkedIn))
                {
                    var linkedInDisplay = Model.Personal.LinkedIn?.Replace("https://", string.Empty, StringComparison.OrdinalIgnoreCase) ?? "LinkedIn";
                    <a href="@Model.Personal.LinkedIn" target="_blank" rel="noopener noreferrer" class="flex items-center justify-end gap-2 hover:text-indigo-600 transition-colors group text-black">
                        <span class="group-hover:underline break-all">@linkedInDisplay</span>
                        <svg width="16" height="16" class="w-4 h-4 text-indigo-600 shrink-0" fill="#4f46e5" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model?.Personal?.Phone))
                {
                    <div class="flex items-center justify-end gap-2">
                        <span>@Model.Personal.Phone</span>
                        <svg width="16" height="16" class="w-4 h-4 text-indigo-600 shrink-0" fill="none" stroke="#4f46e5"
                             viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                            </path>
                        </svg>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-4 h-full overflow-hidden">

            <div class="w-[30%] flex flex-col gap-5 border-r border-gray-200 pr-4">

                @if (Model?.Education != null && Model.Education.Any())
                {
                    <div>
                        <h3
                            class="text-sm font-bold tracking-widest text-slate-800 mb-2 border-b border-gray-300 pb-1 uppercase">
                            Education</h3>
                            <div class="flex flex-col gap-3">
                                @foreach (var edu in Model.Education)
                                {
                                    <div>
                                        <h4 class="font-bold text-sm text-gray-800 leading-tight">@edu.Degree, @edu.FieldOfStudy
                                        </h4>
                                        <div class="italic text-black text-xs">@edu.Institution</div>
                                        <div class="text-xs font-semibold text-indigo-600 mt-0.5">
                                            <!-- Ensures year-only logic for start and end dates -->
                                            @GetYear(edu?.StartYear?.ToString()) - @GetYear(edu?.EndYear?.ToString())
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (Model?.Projects != null && Model.Projects.Any())
                    {
                        <div>
                            <h3
                                class="text-sm font-bold tracking-widest text-slate-800 mb-2 border-b border-gray-300 pb-1 uppercase">
                                Projects</h3>
                                <div class="flex flex-col gap-3">
                                    @foreach (var proj in Model.Projects)
                                    {
                                        <div>
                                            <div class="flex justify-between items-baseline">
                                                <h4 class="font-bold text-sm text-gray-800">@proj.Name</h4>
                                            </div>
                                            <ul class="list-disc pl-4 mt-1 text-xs text-gray-600 space-y-1">
                                                @foreach (var desc in proj?.Description ?? Enumerable.Empty<string>())
                                                {
                                                    <li>@desc</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model?.Achievements != null && Model.Achievements.Any())
                        {
                            <div>
                                <h3
                                    class="text-sm font-bold tracking-widest text-slate-800 mb-2 border-b border-gray-300 pb-1 uppercase">
                                    Achievements</h3>
                                    <div class="flex flex-col gap-2">
                                        @foreach (var ach in Model.Achievements)
                                        {
                                            <div>
                                                <h4 class="font-bold text-sm text-gray-800 inline">@ach.Title</h4>
                                                <span
                                                class="text-xs font-semibold text-indigo-600 ml-1">(@GetYear(ach?.Date?.ToString()))</span>
                                                <div class="italic text-black text-xs mb-0.5">@ach?.Issuer</div>
                                                <p class="text-xs text-gray-600 leading-tight">@ach?.Description</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (Model?.Skills != null && Model.Skills.Any())
                            {
                                <div class="mb-6">
                                    <h3
                                        class="text-xs font-bold tracking-widest text-slate-500 mb-3 uppercase border-b border-gray-200 pb-1">
                                        Skills</h3>
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var skill in Model.Skills)
                                            {
                                                <span
                                                    class="bg-indigo-50 text-indigo-700 text-[10px] font-bold px-2 py-1 rounded border border-indigo-100 uppercase tracking-tight">
                                                    @skill
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (Model?.Interests != null && Model.Interests.Any())
                                {
                                    <div class="mb-6">
                                        <h3
                                            class="text-xs font-bold tracking-widest text-slate-500 mb-3 uppercase border-b border-gray-200 pb-1">
                                            Interests</h3>
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var interest in Model.Interests)
                                                {
                                                    <span
                                                        class="bg-gray-50 text-black text-[10px] font-bold px-2 py-1 rounded border border-gray-200 uppercase tracking-tight">
                                                        @interest
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (Model?.Languages != null && Model.Languages.Any())
                                    {
                                        <div class="mb-6">
                                            <h3
                                                class="text-xs font-bold tracking-widest text-slate-500 mb-3 uppercase border-b border-gray-200 pb-1">
                                                Languages</h3>
                                                <div class="flex flex-col gap-1.5">
                                                    @foreach (var lang in Model.Languages)
                                                    {
                                                        <div class="flex items-baseline justify-between text-xs">
                                                            <!-- Mapped to lang.Language based on the JSON response -->
                                                            <span class="font-bold text-gray-800">@lang.Name</span>
                                                            <span class="flex-1 mx-2 border-b border-dotted border-gray-300 translate-y-[-4px]"></span>
                                                            <span class="text-black italic">@lang.Proficiency</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                    </div>

                                    <div class="w-[70%] flex flex-col gap-4">
                                        @if (Model?.Experiences != null && Model.Experiences.Any())
                                        {
                                            <div>
                                                <h3
                                                    class="text-lg font-bold tracking-widest text-slate-800 mb-4 border-b-2 border-indigo-600 pb-1 uppercase">
                                                    Experience
                                                </h3>
                                                <div class="flex flex-col gap-4">
                                                    @foreach (var exp in Model.Experiences)
                                                    {
                                                        <div>
                                                            <div class="flex justify-between items-baseline mb-1">
                                                                <h4 class="font-bold text-indigo-600 text-base">@exp.Position</h4>
                                                                <div
                                                                    class="text-xs font-bold text-indigo-600 tracking-wider bg-indigo-50 px-2 py-0.5 rounded">
                                                                    <!-- Ensures year-only logic for start and end dates -->
                                                                    @GetYear(exp?.StartYear?.ToString()) - @GetYear(exp?.EndYear?.ToString())
                                                                </div>
                                                            </div>

                                                            <div class="italic text-black text-sm mb-2 font-medium">@exp?.Company</div>

                                                            <ul class="list-disc pl-4 text-xs text-black space-y-1.5 leading-relaxed">
                                                                @foreach (var desc in exp?.Description ?? Enumerable.Empty<string>())
                                                                {
                                                                    <li>@desc</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                            <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
                            <script>
                                document.getElementById("download-pdf-btn").addEventListener("click", function ()
                                {
                                const element = document.getElementById("cv-template");
                                const btn = this;

                                // 1. Hide the button
                                btn.style.display = 'none';

                                // 2. Remove the shadow so it doesn't bleed over the page boundaries
                                element.classList.remove("shadow-2xl");

                                html2pdf().set({
                                margin: 0,
                                filename: '@(Model?.Personal?.Name?.Replace(" ", "_") ?? "Resume").pdf',
                                image: { type: 'jpeg', quality: 0.98 },
                                html2canvas: {
                                scale: 2,
                                useCORS: true,
                                scrollY: 0,
                                scrollX: 0
                                },
                                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                                }).from(element).save().then(() =>
                                {

                                // 3. Bring the button and shadow back after the PDF is downloaded
                                btn.style.display = 'block';
                                element.classList.add("shadow-2xl");
                                });
                                });
                            </script>
                        </body>

                    </html>